{
  "publisher": "opurom",
  "name": "vscode-opurom",
  "displayName": "Opurom",
  "description": "Syntax, snippets, compiler diagnostics, and IR state debugging for Opurom 0.1.0.",
  "version": "0.1.0",
  "categories": ["Programming Languages", "Snippets", "Debuggers"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:opurom",
    "onCommand:opurom.compile",
    "onCommand:opurom.check",
    "onCommand:opurom.run",
    "onCommand:opurom.showActiveDocumentInfo",
    "onCommand:opurom.restartLanguageServer",
    "onCommand:opurom.hotReload",
    "onCommand:opurom.hotRestart",
    "onCommand:opurom.openInspector",
    "onDebug",
    "onDebugResolve:opurom"
  ],
  "main": "./extension.js",
  "icon": "./logo.png",
  "contributes": {
    "languages": [
      {
        "id": "opurom",
        "aliases": ["Opurom", "opurom"],
        "extensions": [".opu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "opurom",
        "scopeName": "source.opurom",
        "path": "./syntaxes/opurom.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "opurom",
        "path": "./snippets/opurom.json"
      }
    ],
    "breakpoints": [
      {
        "language": "opurom"
      }
    ],
    "commands": [
      {
        "command": "opurom.compile",
        "title": "Compile Opurom to IR",
        "category": "Opurom"
      },
      {
        "command": "opurom.check",
        "title": "Check Opurom file",
        "category": "Opurom"
      },
      {
        "command": "opurom.run",
        "title": "Run Opurom (compile and debug)",
        "category": "Opurom"
      },
      {
        "command": "opurom.showActiveDocumentInfo",
        "title": "Show active Opurom document info",
        "category": "Opurom"
      },
      {
        "command": "opurom.restartLanguageServer",
        "title": "Restart Opurom language server",
        "category": "Opurom"
      },
      {
        "command": "opurom.hotReload",
        "title": "Hot reload",
        "category": "Opurom"
      },
      {
        "command": "opurom.hotRestart",
        "title": "Hot restart",
        "category": "Opurom"
      },
      {
        "command": "opurom.openInspector",
        "title": "Open inspector",
        "category": "Opurom"
      }
    ],
    "keybindings": [
      {
        "command": "opurom.run",
        "key": "F5",
        "when": "editorLangId == opurom"
      },
      {
        "command": "opurom.hotReload",
        "key": "Ctrl+F5",
        "when": "inDebugMode && debugType == opurom"
      }
    ],
    "debuggers": [
      {
        "type": "opurom",
        "label": "Opurom IR",
        "program": "../../opurom-debug/bin/server.mjs",
        "runtime": "node",
        "languages": ["opurom"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to an Opurom IR 0.1.0 JSON file."
              },
              "steps": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "Core stdin commands such as tap and input."
              },
              "coreBinary": {
                "type": "string",
                "description": "Optional path to the opurom-core executable."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "opurom",
            "request": "launch",
            "name": "Debug Opurom IR",
            "program": "${workspaceFolder}/counter.opuir.json",
            "steps": ["tap 4", "tap 4", "tap 4"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Opurom",
      "properties": {
        "opurom.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opuromc. Empty uses ../opurom-lang/target/debug/opuromc."
        },
        "opurom.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opurom-cli/bin/opurom.mjs. Empty uses opuromc check."
        },
        "opurom.lspPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opurom-lsp/bin/server.mjs. Empty uses ../opurom-lsp/bin/server.mjs."
        },
        "opurom.inspectorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5178/inspector",
          "scope": "window",
          "description": "Dev server inspector page; run opurom dev to serve it."
        }
      }
    }
  }
}
