{
  "publisher": "opurom",
  "name": "vscode-opurom",
  "displayName": "OPUROM",
  "description": "Syntax, snippets, compiler diagnostics, and IR state debugging for OPUROM v0.1.",
  "version": "0.1.0",
  "categories": ["Programming Languages", "Snippets", "Debuggers"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:opurom",
    "onCommand:opurom.compile",
    "onCommand:opurom.check",
    "onCommand:opurom.run",
    "onCommand:opurom.showActiveDocumentInfo",
    "onCommand:opurom.restartLanguageServer",
    "onDebug",
    "onDebugResolve:opurom"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "opurom",
        "aliases": ["OPUROM", "opurom"],
        "extensions": [".opu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "opurom",
        "scopeName": "source.opurom",
        "path": "./syntaxes/opurom.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "opurom",
        "path": "./snippets/opurom.json"
      }
    ],
    "commands": [
      {
        "command": "opurom.compile",
        "title": "Compile OPUROM to IR",
        "category": "OPUROM"
      },
      {
        "command": "opurom.check",
        "title": "Check OPUROM file",
        "category": "OPUROM"
      },
      {
        "command": "opurom.run",
        "title": "Run OPUROM (compile and debug)",
        "category": "OPUROM"
      },
      {
        "command": "opurom.showActiveDocumentInfo",
        "title": "Show active OPUROM document info",
        "category": "OPUROM"
      },
      {
        "command": "opurom.restartLanguageServer",
        "title": "Restart OPUROM language server",
        "category": "OPUROM"
      }
    ],
    "keybindings": [
      {
        "command": "opurom.run",
        "key": "F5",
        "when": "editorLangId == opurom"
      }
    ],
    "debuggers": [
      {
        "type": "opurom",
        "label": "OPUROM IR",
        "program": "../../opurom-debug/bin/server.mjs",
        "runtime": "node",
        "languages": ["opurom"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to an OPUROM IR v0.1 JSON file."
              },
              "steps": {
                "type": "array",
                "items": { "type": "string" },
                "default": [],
                "description": "Core stdin commands such as tap and input."
              },
              "coreBinary": {
                "type": "string",
                "description": "Optional path to the opurom-core executable."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "opurom",
            "request": "launch",
            "name": "Debug OPUROM IR",
            "program": "${workspaceFolder}/counter.opuir.json",
            "steps": ["tap 4", "tap 4", "tap 4"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "OPUROM",
      "properties": {
        "opurom.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opuromc. Empty uses ../opurom-lang/target/debug/opuromc."
        },
        "opurom.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opurom-cli/bin/opurom.mjs. Empty uses opuromc check."
        },
        "opurom.lspPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to opurom-lsp/bin/server.mjs. Empty uses ../opurom-lsp/bin/server.mjs."
        }
      }
    }
  }
}
