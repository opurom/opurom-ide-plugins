{
  "New OPUROM app": {
    "prefix": "opurom-app",
    "body": [
      "app ${1:Counter} {",
      "\tstate ${2:count} = ${3:0}",
      "",
      "\tColumn(gap: 8, padding: 16) {",
      "\t\tText(\"Count: {${2:count}}\", size: 24)",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Create a new OPUROM app with state and a Column"
  },
  "Column with Text": {
    "prefix": "opurom-column-text",
    "body": [
      "Column(gap: ${1:8}, padding: ${2:16}, align: ${3:center}) {",
      "\tText(\"${4:Hello, OPUROM}\", size: ${5:24})",
      "}",
      "$0"
    ],
    "description": "Insert a Column containing one Text node"
  },
  "Button increment": {
    "prefix": "opurom-button-inc",
    "body": ["Button(\"${1:+}\") { ${2:count} += 1 }"],
    "description": "Insert a Button whose tap handler increments an int state with += 1"
  },
  "Bound Input": {
    "prefix": "opurom-input-bind",
    "body": ["Input(placeholder: \"${1:Your name}\", bind: ${2:name})"],
    "description": "Insert an Input bound to a string state"
  }
}
