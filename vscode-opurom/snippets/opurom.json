{
  "New OPUROM app": {
    "prefix": "opurom-app",
    "body": [
      "app ${1:Counter} {",
      "\tstate ${2:count} = ${3:0}",
      "",
      "\tColumn(gap: 8, padding: 16) {",
      "\t\tText(\"Count: {${2:count}}\", size: 24)",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Create a new OPUROM app with state and a Column"
  },
  "Column with Text": {
    "prefix": "opurom-column-text",
    "body": [
      "Column(gap: ${1:8}, padding: ${2:16}, align: ${3:center}) {",
      "\tText(\"${4:Hello, OPUROM}\", size: ${5:24})",
      "\t}",
      "$0"
    ],
    "description": "Insert a Column containing one Text node"
  },
  "Button increment": {
    "prefix": "opurom-button-inc",
    "body": ["Button(\"${1:+}\") { ${2:count} += 1 }"],
    "description": "Insert a Button whose tap handler increments an int state with += 1"
  },
  "Bound Input": {
    "prefix": "opurom-input-bind",
    "body": ["Input(placeholder: \"${1:Your name}\", bind: ${2:name})"],
    "description": "Insert an Input bound to a string state"
  },
  "Full-stack model and api": {
    "prefix": "opurom-fullstack",
    "body": [
      "app ${1:TodoApp} {",
      "\tmodel ${2:Todo} {",
      "\t\t${3:id}: int primary",
      "\t\t${4:title}: string",
      "\t\t${5:done}: bool = false",
      "\t}",
      "",
      "\tapi \"${6:/todos}\" {",
      "\t\tlist ${2:Todo}",
      "\t\tcreate ${2:Todo}",
      "\t}",
      "",
      "\tapi \"${6:/todos}/:id\" {",
      "\t\tget ${2:Todo}",
      "\t\tupdate ${2:Todo}",
      "\t\tdelete ${2:Todo}",
      "\t}",
      "",
      "\tstate ${7:remaining} = 0",
      "\tColumn(p: 16) {",
      "\t\tText(\"Remaining: {${7:remaining}}\")",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Insert an app with a model, two api blocks and a state"
  },
  "Particle field Container": {
    "prefix": "opurom-particles",
    "body": [
      "Container(p: ${1:16}, rounded: ${2:12}, animate: ${3|spring,ease,none|},",
      "\tparticles: \"count=${4:64},seed=${5:7},radius=${6:3}\") {",
      "\tText(\"${7:Particle field}\")",
      "}",
      "$0"
    ],
    "description": "Insert a Container with a seeded particles field and an animation"
  },
  "Theme block": {
    "prefix": "opurom-theme",
    "body": [
      "theme { mode: ${1|dark,light|}, accent: \"${2:#FF4D6D}\", radius: ${3:8} }",
      "$0"
    ],
    "description": "Insert a theme block with mode, accent and radius"
  },
  "Conditional if": {
    "prefix": "if",
    "body": [
      "if (${1:state}) {",
      "\t${2:Text(\"Visible\")}",
      "}",
      "$0"
    ],
    "description": "Insert a conditional rendering block"
  },
  "Conditional if/else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:state}) {",
      "\t${2:Text(\"Visible\")}",
      "} else {",
      "\t${3:Text(\"Hidden\")}",
      "}",
      "$0"
    ],
    "description": "Insert conditional rendering with both branches"
  },
  "Default theme": {
    "prefix": "theme",
    "body": ["theme { accent: \"#097FEB\", radius: 12 }", "$0"],
    "description": "Insert the default theme block"
  },
  "Feedback or overlay component": {
    "prefix": "opurom-feedback-overlay",
    "body": [
      "${1|Confirm,Drawer,Toast,SuccessToast,WarningToast,ErrorToast,Tooltip,HoverTooltip,Notification,Badge,StatusBadge,ProgressBar,Progress,RadialProgress,Spinner,LoadingSpinner,Skeleton,SkeletonCard,Avatar,StatusAvatar|}()",
      "$0"
    ],
    "description": "Insert a feedback or overlay catalog component"
  }
}
