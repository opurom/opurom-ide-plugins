{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OPUROM",
  "scopeName": "source.opurom",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#node-kinds" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#property-names" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.opurom",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.opurom",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.opurom", "match": "\\\\." },
        { "name": "constant.character.escape.opurom", "match": "\\{\\{" },
        {
          "name": "meta.interpolation.opurom",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "name": "variable.other.interpolation.opurom", "match": "[A-Za-z_][A-Za-z0-9_]*" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.opurom",
      "match": "\\b(?:app|state)\\b"
    },
    "node-kinds": {
      "name": "support.class.node.opurom",
      "match": "\\b(?:Column|Row|Container|Text|Button|Input|Image|Spacer)\\b"
    },
    "numbers": {
      "name": "constant.numeric.opurom",
      "match": "-?\\b[0-9]+\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.opurom",
      "match": "\\b(?:true|false)\\b"
    },
    "operators": {
      "name": "keyword.operator.opurom",
      "match": "\\+=|-=|=(?!=)|\\.toggle\\(\\)"
    },
    "property-names": {
      "name": "variable.parameter.prop.opurom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
    },
    "identifiers": {
      "name": "variable.other.identifier.opurom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "punctuation": {
      "name": "punctuation.opurom",
      "match": "[{}(),;:]"
    }
  }
}
